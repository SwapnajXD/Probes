# Version control
.git
.gitignore
.github
.agents/
.codex/
.aws/
portfolio-export/

# Kubernetes manifests and docs - not needed inside the running container
k8s/
docs/
README.md
LICENSE

# Tests and dev-only dependencies - not needed at runtime
tests/
requirements-dev.txt
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coveragerc
.coverage
coverage.svg

# Runtime data is supplied separately from the image
health.db
*.db

# Local configuration, archives, and repository dumps
.env
.env.*
*.zip
project_dump.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store
